<Window x:Class="ScreenRecorder.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="屏录球 · 设置" Width="520" Height="680"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FF16161A" Foreground="#FFF2F3F5"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF2F3F5" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF8AB4F8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFF2F3F5" />
            <Setter Property="Margin" Value="0,4,16,4" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFF2F3F5" />
            <Setter Property="Margin" Value="0,5,0,5" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Foreground" Value="#FFA9AFBA" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="录制区域" Style="{StaticResource Section}" />
                <RadioButton x:Name="RbPrimary" GroupName="area" Content="主显示器" />
                <RadioButton x:Name="RbFull" GroupName="area" Content="所有显示器（虚拟桌面）" />
                <RadioButton x:Name="RbMonitor" GroupName="area" Content="指定显示器：" />
                <ComboBox x:Name="CmbMonitors" Margin="20,2,0,4" />
                <RadioButton x:Name="RbRegion" GroupName="area" Content="自定义区域" />
                <StackPanel Orientation="Horizontal" Margin="20,2,0,4">
                    <TextBlock x:Name="TxtRegion" Text="未选择" Foreground="#FFA9AFBA" VerticalAlignment="Center" />
                    <Button x:Name="BtnPickRegion" Content="框选区域" Margin="10,0,0,0" Padding="10,3" />
                </StackPanel>

                <TextBlock Text="声音" Style="{StaticResource Section}" />
                <RadioButton x:Name="RbAudioBoth" GroupName="audio" Content="系统声音 + 麦克风" />
                <RadioButton x:Name="RbAudioSystem" GroupName="audio" Content="仅系统声音" />
                <RadioButton x:Name="RbAudioMic" GroupName="audio" Content="仅麦克风" />
                <RadioButton x:Name="RbAudioNone" GroupName="audio" Content="不录音" />

                <TextBlock Text="系统声音音量" Margin="0,10,0,0" />
                <Slider x:Name="SldSysVol" Minimum="0" Maximum="150" TickFrequency="10" IsSnapToTickEnabled="True" />
                <TextBlock Text="麦克风音量" Margin="0,6,0,0" />
                <Slider x:Name="SldMicVol" Minimum="0" Maximum="150" TickFrequency="10" IsSnapToTickEnabled="True" />
                <TextBlock Text="麦克风设备" Margin="0,8,0,0" />
                <ComboBox x:Name="CmbMics" />

                <TextBlock Text="画质" Style="{StaticResource Section}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="帧率" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox x:Name="CmbFps" Grid.Column="1" />
                </Grid>
                <TextBlock Text="清晰度" Margin="0,8,0,0" />
                <ComboBox x:Name="CmbQuality" />

                <TextBlock Text="保存位置" Style="{StaticResource Section}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtOutput" Padding="6,4" VerticalContentAlignment="Center" />
                    <Button x:Name="BtnBrowse" Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Padding="10,4" />
                </Grid>

                <TextBlock Text="其他" Style="{StaticResource Section}" />
                <CheckBox x:Name="ChkOpenFolder" Content="录制完成后自动打开保存文件夹" />
                <CheckBox x:Name="ChkSound" Content="开始/停止时播放提示音" />
                <CheckBox x:Name="ChkTray" Content="在通知区域显示托盘图标" />
                <TextBlock Text="悬浮球大小" Margin="0,8,0,0" />
                <Slider x:Name="SldBallSize" Minimum="48" Maximum="120" TickFrequency="4" IsSnapToTickEnabled="True" />

                <TextBlock x:Name="TxtInfo" Style="{StaticResource Hint}" Margin="0,14,0,0" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnCancel" Content="取消" Padding="18,7" Margin="0,0,10,0" />
            <Button x:Name="BtnOk" Content="保存" Padding="22,7" Background="#FFE23B3B" Foreground="White" BorderThickness="0" />
        </StackPanel>
    </Grid>
</Window>

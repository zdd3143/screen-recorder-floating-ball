<Window x:Class="ScreenRecorder.UI.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择录制区域" WindowStyle="None" AllowsTransparency="True"
        Background="#66000000" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize" Cursor="Cross" WindowStartupLocation="Manual">
    <Grid>
        <Canvas x:Name="Overlay">
            <Border x:Name="Selection" Visibility="Collapsed"
                    BorderBrush="#FF3DDC84" BorderThickness="2" Background="#2200FF88">
                <TextBlock x:Name="SizeLabel" Foreground="White" FontSize="14" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0" />
            </Border>
        </Canvas>
        <TextBlock Text="拖动鼠标框选录制区域，回车确认 / Esc 取消"
                   Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Top"
                   Margin="0,40,0,0" />
    </Grid>
</Window>
